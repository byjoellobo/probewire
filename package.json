{
  "name": "probewire",
  "version": "0.1.0",
  "private": true,
  "description": "A logic analyzer in your browser tab: Web Serial drivers for Raspberry Pi Pico analyzers, UART/I2C/SPI decoders, and sigrok .sr files that open in PulseView.",
  "keywords": [
    "logic-analyzer",
    "web-serial",
    "webusb",
    "pwa",
    "raspberry-pi-pico",
    "sigrok",
    "pulseview",
    "uart",
    "i2c",
    "spi",
    "protocol-decoder",
    "embedded"
  ],
  "homepage": "https://byjoellobo.github.io/probewire/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/byjoellobo/probewire.git"
  },
  "bugs": {
    "url": "https://github.com/byjoellobo/probewire/issues"
  },
  "author": "Joel Lobo (https://github.com/byjoellobo)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "icons": "pwa-assets-generator --preset minimal-2023 public/logo.svg"
  },
  "dependencies": {
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "fflate": "^0.8.3",
    "preact": "^11.2.0",
    "web-serial-polyfill": "^1.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^24.19.2",
    "@types/w3c-web-serial": "^1.0.9",
    "@types/w3c-web-usb": "^1.0.14",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.0.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-window": "^7.4.1"
  }
}
