{
  "name": "logic-in-a-tab",
  "version": "0.1.0",
  "private": true,
  "description": "A logic analyzer that runs in your browser: Web Serial drivers for Pico-based analyzers, UART/I2C/SPI decoders, sigrok .sr import/export.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "icons": "pwa-assets-generator --preset minimal-2023 public/logo.svg"
  },
  "dependencies": {
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "fflate": "^0.8.3",
    "preact": "^10.29.8",
    "web-serial-polyfill": "^1.0.15"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/w3c-web-serial": "^1.0.9",
    "@types/w3c-web-usb": "^1.0.14",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "fake-indexeddb": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-window": "^7.4.1"
  }
}
